{
  "input": "metagenomic_totla/non_asd_qc_pass_reported_blank.tsv.gz",
  "output_dir": "metagenomic_totla/transformer_no_unknown",
  "excluded_features": ["Unknown"],
  "epochs": 100,
  "mask_fraction": 0.1,
  "accumulate_samples": 16,
  "seed": 42,
  "d_model": 512,
  "num_heads": 8,
  "num_layers": 6,
  "d_ff": 2048,
  "encoder_dropout": 0.1,
  "head_hidden": [1024, 2048],
  "scale_abundance_embedding": true,
  "adam_beta1": 0.9,
  "adam_beta2": 0.98,
  "adam_epsilon": 1e-9,
  "warmup_updates": 4000,
  "learning_rate_factor": 1.0,
  "checkpoint_every": 5,
  "plot_every": 10,
  "diagnostic_samples": 128,
  "save_mask_logs": true,
  "progress_every": 1000,
  "device": "auto",
  "threads": 10
}
