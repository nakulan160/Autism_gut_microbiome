      "project_id": "PRJNA961076",
      "original_sample_description": "Identification of taxonomic changes in feces bacteriome associated with colorectal polyps and cancer: potential biomarkers for early diagnosis",
      "run_id": "SRR24315722",
      "experiment_type": "Metagenomics",
      "instrument_model": "Illumina MiSeq",
      "nr_reads_sequenced": 32262818,
