      "project_id": "PRJEB12449",
      "original_sample_description": "Reproducibility of associations between the human gut microbiome and colorectal cancer assessed in a patient population from Washington\\ DC\\ USA",
      "run_id": "ERR1293848",
      "experiment_type": "Metagenomics",
      "instrument_model": "Illumina",
