      "original_sample_description": "Different development status of gut microbiome link to the dysbiosis of gut ecosystem in early childhood with atopic dermatitis",
      "run_id": "ERR6002193",
      "experiment_type": "Metagenomics",
      "instrument_model": "Illumina HiSeq 2500",
