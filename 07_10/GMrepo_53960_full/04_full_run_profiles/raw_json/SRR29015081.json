      "project_id": "PRJNA1111312",
      "original_sample_description": "Shotgun metagenomics reveals Bacteroides stercoris as a fecal biomarker depleted in late-stage hepatocellular carcinoma",
      "run_id": "SRR29015081",
      "experiment_type": "Metagenomics",
      "instrument_model": "NextSeq 550",
