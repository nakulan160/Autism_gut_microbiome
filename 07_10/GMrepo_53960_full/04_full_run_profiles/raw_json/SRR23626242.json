      "project_id": "PRJNA938297",
      "original_sample_description": "Eubacterium rectale differentiates gut microbiota among psoriasis and psoriatic arthritis patients",
      "run_id": "SRR23626242",
      "experiment_type": "Metagenomics",
      "instrument_model": "Illumina NovaSeq 6000",
