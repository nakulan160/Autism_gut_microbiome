      "project_id": "PRJNA1138893",
      "original_sample_description": "The aim of this study was to analyze the differences in gut microbiota, metabolites, and metabolic pathways between healthy individuals and patients with colorectal cancer",
      "run_id": "SRR29930212",
      "experiment_type": "Metagenomics",
      "instrument_model": "Illumina NovaSeq 6000",
